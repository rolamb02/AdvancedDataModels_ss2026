# QUERY 7 – Federated Query gegen DBpedia (optional / Bonus)
# Fragt LIVE den öffentlichen DBpedia SPARQL-Endpunkt ab
# Kombiniert unsere lokalen Daten mit globalem Linked Data
#
# Was hier passiert:
#   SERVICE = "frag diesen externen Endpunkt"
#   Der lokale Triplestore sendet die Teilanfrage an DBpedia
#   Ergebnisse werden automatisch zusammengeführt
#
# Zeigt: Wie lokale und globale Ressourcen per owl:sameAs verknüpft werden
# (uni:Stuttgart -> dbr:Stuttgart)
#
# Hinweis: Braucht Internetzugang. DBpedia-Endpunkt kann langsam sein.
# Als Fallback: Screenshot der Ergebnisse zeigen.

PREFIX uni:    <http://example.org/uni/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX dbo:    <http://dbpedia.org/ontology/>

SELECT ?uniname ?stadtname ?description
WHERE {
    # Aus unserem lokalen Store: alle Universitäten in BW
    ?u  a uni:University .
    ?u  rdfs:label ?uniname .
    ?u  uni:location ?stadt .
    ?stadt uni:bundesland "Baden-W\u00FCrttemberg" .
    ?stadt rdfs:label ?stadtname .
    ?stadt owl:sameAs ?dbCity .

    # Von DBpedia: Beschreibung zur verlinkten Stadt-Ressource
    SERVICE <https://dbpedia.org/sparql> {
        ?dbCity dbo:abstract ?description .
        FILTER (lang(?description) = "de")
    }
}
